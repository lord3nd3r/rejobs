# Gunicorn systemd service for Re Jobs
# Place in: /etc/systemd/system/rejobs.service
# Enable: sudo systemctl enable rejobs && sudo systemctl start rejobs

[Unit]
Description=Re Jobs — Gunicorn WSGI server
After=network.target postgresql.service

[Service]
User=rejobs
Group=www-data
WorkingDirectory=/home/rejobs/app
EnvironmentFile=/home/rejobs/app/.env

ExecStart=/home/rejobs/venv/bin/gunicorn \
    --workers 4 \
    --worker-class sync \
    --bind 127.0.0.1:8000 \
    --timeout 30 \
    --access-logfile /var/log/rejobs/access.log \
    --error-logfile /var/log/rejobs/error.log \
    --log-level info \
    config.wsgi:application

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
